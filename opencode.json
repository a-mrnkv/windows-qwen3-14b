{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3-local",
  "small_model": "ollama/qwen3-local",
  "enabled_providers": [
    "ollama"
  ],
  "share": "disabled",
  "autoupdate": false,
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local Qwen)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen3-local": {
          "name": "Qwen3 14B (local prompt)",
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    }
  }
}
